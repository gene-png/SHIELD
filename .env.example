# =====================================================================
# SHIELD — environment configuration. Copy to .env and fill in secrets.
# .env is gitignored. Never commit real keys.
# =====================================================================

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-long-random-string-in-real-deploys
APP_BASE_URL=http://localhost:8000

# --- Database ---
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield_dev_password
POSTGRES_DB=shield
DATABASE_URL=postgresql+psycopg://shield:shield_dev_password@db:5432/shield

# --- Redis / RQ (async AI worker) ---
# The Flask app enqueues AI calls here so the request thread never
# blocks on Anthropic. The `worker` container runs `rq worker shield-ai`
# against this URL and executes the jobs.
REDIS_URL=redis://redis:6379/0

# --- Anthropic Claude API ---
# Get a key at https://console.anthropic.com/.
# Used by BOTH the in-app AI engine (extraction, overlap, posture, ATT&CK
# coverage) AND the headless dev agent inside the dev-agent container.
ANTHROPIC_API_KEY=

# Model defaults
ANTHROPIC_MODEL_APP=claude-opus-4-7
ANTHROPIC_MODEL_AGENT=claude-sonnet-4-6

# Soft per-call max output tokens. 16384 is the practical operating
# point: fits ~100 of 222 P3 ATT&CK findings and finishes well inside
# the 600s RQ job timeout. The truncation-aware parser in
# shield/tasks.py recovers what did fit when the response gets cut off,
# so a partial response is still actionable.
ANTHROPIC_MAX_OUTPUT_TOKENS=16384

# Retries for transient 429 / 5xx errors. SDK uses exponential backoff.
# 2 is the SDK default; we keep it low because the per-call timeout
# below is generous enough to absorb most slow calls in one attempt,
# and stacking retries against a consistently-slow call just wastes
# the RQ job-timeout budget.
ANTHROPIC_MAX_RETRIES=2

# SDK-level per-call timeout (seconds). Generating 16K output tokens
# at ~50 tok/sec takes ~5 min for the P3 ATT&CK coverage call. 600s
# gives one full attempt the room to complete; the RQ job-level
# default_timeout is 1200s so the worker doesn't kill it from above.
ANTHROPIC_TIMEOUT_SECONDS=600

# --- Keycloak (mock GCC High Entra ID) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=shield-dev
KEYCLOAK_CLIENT_ID=shield-app
KEYCLOAK_CLIENT_SECRET=shield-app-dev-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Feature flags ---
# AI_MODE=real     -> calls Anthropic API
# AI_MODE=fixture  -> returns canned fixtures (offline / CI safe)
AI_MODE=real
